{
  "expo": {
    "name": "GAMOIWERE",
    "slug": "gamoiwere",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamoiwere.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.gamoiwere.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24d6f790-9fe4-40fc-b537-5500c6acb7f7"
      }
    },
    "owner": "gamoiwere"
  }
}
