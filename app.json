{
  "expo": {
    "name": "GAMOIWERE",
    "slug": "bolt-expo-nativewind",
    "version": "2.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/appicon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/appicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamoiwere.app",
      "icon": "./assets/images/appicon.png",
      "buildNumber": "12",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "გთხოვთ დაუშვათ Face ID ავტორიზაციისთვის"
      }
    },
    "android": {
      "package": "com.gamoiwere.app",
      "versionCode": 214,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/appicon.png",
        "backgroundColor": "#7C3AED"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "გთხოვთ დაუშვათ Face ID ავტორიზაციისთვის"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24d6f790-9fe4-40fc-b537-5500c6acb7f7"
      }
    },
    "owner": "gamoiwere"
  }
}
